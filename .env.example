# courtWatcher environment — copy to .env (git-ignored) and fill in. Empty optional lines use the default.
# Used by: CLI = bin/find-court (agents/skill), BOT = scripts/telegram_bot.py (Docker image), WATCH = --watch alerts.

# --- Lazuz (required for every availability check: CLI, BOT, WATCH) ---
# Long-lived refresh token from the Lazuz app login (~13 years). Required.
LAZUZ_REFRESH_TOKEN=
# Short-lived access token (~16 min). Optional: refreshed automatically and written back to .env.
LAZUZ_AUTH_TOKEN=
# Optional overrides — leave empty for the defaults (https://server.lazuz.co.il, app version 5.2.3, built-in app-check key).
LAZUZ_BASE_URL=
LAZUZ_APP_VERSION=
LAZUZ_APPCHECK_KEY=

# --- Free-text understanding: Gemini Decisions API (CLI, BOT) ---
# Gemini API key from https://aistudio.google.com/api-keys (project with billing/credits or free tier). Required for free text.
GEMINI_API_KEY=
# Optional — defaults: gemini-decision-1 on v1beta. Set API_VERSION=v1 once Google ships GA.
GEMINI_DECISION_MODEL=
GEMINI_DECISION_API_VERSION=

# --- Telegram ---
# Bot token from @BotFather. Required for BOT; with TELEGRAM_CHAT_ID also enables WATCH alerts from the CLI.
TELEGRAM_BOT_TOKEN=
# Your chat id (numeric) — where CLI --watch and scripts/watch_availability.py send "court available" alerts.
# The bot itself replies to whoever messages it and does not need this.
TELEGRAM_CHAT_ID=
